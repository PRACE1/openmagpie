DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-only-change-me

# Base URL of this backend (used to construct absolute URLs)
BASE_URL=http://localhost:8000

# Ollama (host's Ollama, reachable from the container via host.docker.internal)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Webhook notifier security gates. Defaults are permissive for single-tenant
# self-host (so internal targets like an OpenClaw instance on a private IP work).
# For multi-tenant / public deployments, set both to "true".
# WEBHOOK_REQUIRE_HTTPS=false
# WEBHOOK_BLOCK_PRIVATE_IPS=false
